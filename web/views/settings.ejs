<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Settings</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <%- include('partials/sidebar') %>
    
    <main class="main-content">
      <header class="topbar">
        <h2>Settings</h2>
      </header>

      <div class="content-body">
        <div class="card max-w-lg">
          <form action="/settings" method="POST">
            <div class="form-group mb-20">
              <label for="winRate">当選確率 (0 〜 1)</label>
              <input type="number" id="winRate" name="winRate" class="form-control" step="0.01" min="0" max="1" value="<%= config.winRate %>" required>
              <small class="text-muted">例: 0.4 = 40%</small>
            </div>
            
            <div class="form-group mb-20">
              <label class="checkbox-label">
                <input type="checkbox" name="isMaintenanceMode" <%= config.isMaintenanceMode ? 'checked' : '' %>>
                メンテナンスモードを有効にする
              </label>
              <small class="text-muted block mt-1">有効にすると、ユーザーは /spin コマンドを実行できなくなります。</small>
            </div>

            <button type="submit" class="btn btn-primary">保存</button>
          </form>
        </div>
      </div>
    </main>
  </div>
  <script src="https://unpkg.com/feather-icons"></script>
  <script>feather.replace();</script>
</body>
</html>
